# Copy to .env and fill in. Never commit .env.
# A test key while you build (portal, Test mode › Settings › Developers › API keys), a live key in production.
NOVARO_API_KEY=sk_test_in_...
# The endpoint's signing secret (portal › Settings › Developers › Webhooks),
# or, while you build, the one `novaro listen --print-secret` prints.
NOVARO_WEBHOOK_SECRET=whsec_...
# The API version this code is written for (docs.novaro.ink/api/versioning).
NOVARO_API_VERSION=2026-11-04.acacia
# Where payers reach this server, https: the hosted page sends them back here.
PUBLIC_URL=https://shop.example
PORT=3000
